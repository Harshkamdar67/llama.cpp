#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_integer_dot_product : require

// Flash attention for one query token over a long Q4_0 cache: the scores.
// The cache codes are integers, so a key's dot product with a query quantized to 8 bits (fa_q4_query.comp)
// is four multiply-adds per instruction; the 4-bit keys carry 16 times the rounding error the query adds.
// Workgroup (block of KEYS keys, KV head, token): thread (key lane, query slot) keeps its query's 32 words
// and walks its keys, so nothing goes through shared memory until the block maximum at the end.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint HS    = 128;
const uint NB    = HS/32;
const float NEG  = -3.0e38;

layout(constant_id = 0) const uint KEYS  = 1024;  // keys per workgroup, a multiple of LANES
// query slots: the r <= 4 query heads of the KV head, for the token of the workgroup
const uint MAX_Q = 4;

layout(push_constant) uniform parameter
{
    uint n_kv;
    uint n_head_kv;
    uint r;
    uint nem2;
    uint nbm1;       // mask strides, elements
    uint nbm2;
    uint n_tok;
    uint n_head_q;
    uint m_offset;
    uint s_stride;   // scores per head (n_kv padded to KEYS)
    uint n_wg;
    uint off_mx;
    uint off_q;      // per query head: 32 words, 4 block sums, the scale and 3 unused (40 values)
    float scale;
    uint rel_dist;   // rows of the bias table per query, 0: the mask holds the bias already
    uint rb_offset;
};

struct block_q4 {
    float16_t d;
    uint16_t  qs[8];
};

layout(binding = 0) readonly buffer K  { block_q4  data_k[]; };
layout(binding = 1) readonly buffer M  { float16_t data_m[]; };
layout(binding = 2)          buffer T  { float     data_t[]; };
layout(binding = 2)          buffer TI { int32_t   data_ti[]; };
// relative-position bias [rel_dist, n_head_q, n_tok], read where the mask holds 1 + distance
layout(binding = 3) readonly buffer RB { float     data_rb[]; };

const uint LANES = 256/MAX_Q;

shared float red[256];

void main() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint wg   = gl_WorkGroupID.x;
    const uint hk   = gl_WorkGroupID.y;
    // the threads of a slot are neighbours, so a block of keys its token cannot see is skipped by whole SIMD groups
    const uint slot = tid / LANES;
    const uint lane = tid % LANES;
    const uint t    = gl_WorkGroupID.z;   // a workgroup serves one token, so it skips whole blocks the token cannot see
    const uint hq   = hk*r + slot;
    const uint gq   = t*n_head_q + hq;

    float mx = NEG;

    if (slot < r) {
        // words 8b..8b+3 pair with the low nibbles of block b (its dims 0..15), 8b+4..8b+7 with the high ones
        const uint qb = off_q + gq*40;
        int32_t qw[32];
        [[unroll]] for (uint j = 0; j < 32; ++j) {
            qw[j] = data_ti[qb + j];
        }
        float qsum[NB];
        [[unroll]] for (uint b = 0; b < NB; ++b) {
            qsum[b] = data_t[qb + 32 + b];
        }
        const float qsc  = data_t[qb + 36]*scale;
        const uint  mrow = m_offset + t*nbm1 + (hq % nem2)*nbm2;

        for (uint it = 0; it < KEYS/LANES; ++it) {
            const uint key = wg*KEYS + lane + LANES*it;
            if (key >= n_kv) {
                data_t[gq*s_stride + key] = NEG;
                continue;
            }
            // a hidden key (another stream's, an empty cell): no read of its K
            float m = float(data_m[mrow + key]);
            if (m < -1.0e30) {
                data_t[gq*s_stride + key] = NEG;
                continue;
            }
            const uint ib0 = (key*n_head_kv + hk)*NB;
            float s = 0.0;
            [[unroll]] for (uint b = 0; b < NB; ++b) {
                const uint ib = ib0 + b;
                int32_t acc = 0;
                [[unroll]] for (uint j = 0; j < 4; ++j) {
                    const uint w = uint(data_k[ib].qs[2*j]) | (uint(data_k[ib].qs[2*j + 1]) << 16);
                    acc += dotPacked4x8EXT(int32_t(w & 0x0F0F0F0Fu), qw[8*b + j]) +
                           dotPacked4x8EXT(int32_t((w >> 4) & 0x0F0F0F0Fu), qw[8*b + 4 + j]);
                }
                // codes are value + 8
                s += float(data_k[ib].d)*(float(acc) - 8.0*qsum[b]);
            }
            if (rel_dist != 0 && m > 0.5) {
                m = data_rb[rb_offset + rel_dist*gq + uint(m) - 1u];
            }
            s = s*qsc + m;
            data_t[gq*s_stride + key] = s;
            mx = max(mx, s);
        }
    }

    red[tid] = mx;
    barrier();
    if (tid < MAX_Q && tid < r) {
        float m = NEG;
        for (uint i = 0; i < LANES; ++i) {
            m = max(m, red[tid*LANES + i]);
        }
        data_t[off_mx + (t*n_head_q + hk*r + tid)*n_wg + wg] = m;
    }
}
