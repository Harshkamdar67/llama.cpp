#version 450

// Flash attention over a long Q4_0 cache: add the blocks up, the sink, and normalize.
// Workgroup = (token, query head), thread = value dim.

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

const uint HS = 128;

layout(push_constant) uniform parameter
{
    uint n_wg;
    uint off_mg;
    uint off_p;
    uint d_offset;
    uint has_sinks;  // 1: per head, 2: per token and head
    uint n_head_q;
    uint s_offset;
};

layout(binding = 0) readonly  buffer T { float data_t[]; };
layout(binding = 1) readonly  buffer S { float data_s[]; };
layout(binding = 2) writeonly buffer D { float data_d[]; };

void main() {
    const uint d  = gl_LocalInvocationID.x;
    const uint gq = gl_WorkGroupID.y;   // token*n_head_q + head

    float acc = 0.0;
    float l   = 0.0;
    const uint base = off_p + gq*n_wg*(HS + 1);
    for (uint i = 0; i < n_wg; ++i) {
        acc += data_t[base + i*(HS + 1) + d];
        l   += data_t[base + i*(HS + 1) + HS];
    }
    if (has_sinks != 0) {
        l += exp(data_s[s_offset + (has_sinks == 2 ? gq : gq % n_head_q)] - data_t[off_mg + gq]);
    }
    data_d[d_offset + gq*HS + d] = l > 0.0 ? acc/l : 0.0;
}
