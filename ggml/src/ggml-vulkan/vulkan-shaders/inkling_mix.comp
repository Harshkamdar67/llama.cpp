#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Inkling 2 attention over the depth, in two passes over slices of BLOCK_SIZE elements:
//   z_i = rms_norm(state_i), w[q, i] = softmax_i(query_q . z_i / sqrt(n_embd)), out_q = sum_i w[q, i] z_i
//   pass 0, workgroup (slice, t): the slice's sums of squares and query dot products into scratch
//   pass 1, workgroup (slice, t): add the slices up, softmax, write the slice of every output
// states: the blocks (bindings 2..9) then cur (binding 1). The scratch of token t starts at d_offset + scr_offset + t*nbd2.

layout(constant_id = 0) const uint BLOCK_SIZE = 256;
layout(constant_id = 1) const uint PASS = 0;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

const uint MAX_STATES = 9;
const uint MAX_QUERY  = 4;
const uint N_ACC      = MAX_STATES*(1 + MAX_QUERY);

layout(push_constant) uniform parameter
{
    uint n_embd;
    uint n_query;
    uint n_states;
    uint nbq1;        // query column stride, elements
    uint nbd1;        // dst strides, elements
    uint nbd2;
    uint q_offset;
    uint d_offset;
    uint scr_offset;  // scratch, elements from the start of a token's column
    uint n_slices;
    uint nbs1[MAX_STATES];
    uint s_offset[MAX_STATES];
};

layout(binding = 0)  readonly buffer Q  { float data_q[]; };
layout(binding = 1)  readonly buffer S0 { float data_s0[]; };
layout(binding = 2)  readonly buffer S1 { float data_s1[]; };
layout(binding = 3)  readonly buffer S2 { float data_s2[]; };
layout(binding = 4)  readonly buffer S3 { float data_s3[]; };
layout(binding = 5)  readonly buffer S4 { float data_s4[]; };
layout(binding = 6)  readonly buffer S5 { float data_s5[]; };
layout(binding = 7)  readonly buffer S6 { float data_s6[]; };
layout(binding = 8)  readonly buffer S7 { float data_s7[]; };
layout(binding = 9)  readonly buffer S8 { float data_s8[]; };
layout(binding = 10)          buffer D  { float data_d[]; };

float load_state(uint i, uint t, uint e) {
    const uint idx = s_offset[i] + t*nbs1[i] + e;
    if (i == n_states - 1) return data_s0[idx];
    switch (i) {
        case 0: return data_s1[idx];
        case 1: return data_s2[idx];
        case 2: return data_s3[idx];
        case 3: return data_s4[idx];
        case 4: return data_s5[idx];
        case 5: return data_s6[idx];
        case 6: return data_s7[idx];
        default: return data_s8[idx];
    }
}

shared float red[N_ACC][32];
shared float tot[N_ACC];
shared float wgt[MAX_QUERY][MAX_STATES];

void main() {
    const uint tid   = gl_LocalInvocationID.x;
    const uint slice = gl_WorkGroupID.x;
    const uint t     = gl_WorkGroupID.y;
    const uint e     = slice*BLOCK_SIZE + tid;
    const uint scr   = d_offset + t*nbd2 + scr_offset;

    float x[MAX_STATES];
    [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
        x[i] = (i < n_states && e < n_embd) ? load_state(i, t, e) : 0.0;
    }

    if (PASS == 0) {
        float qv[MAX_QUERY];
        [[unroll]] for (uint q = 0; q < MAX_QUERY; ++q) {
            qv[q] = (q < n_query && e < n_embd) ? data_q[q_offset + q*nbq1 + e] : 0.0;
        }
        // k = i: sum of squares of state i; k = MAX_STATES*(1 + q) + i: query_q . state_i
        [[unroll]] for (uint k = 0; k < N_ACC; ++k) {
            const uint i = k % MAX_STATES;
            const uint q = k / MAX_STATES;
            const float v = subgroupAdd(q == 0 ? x[i]*x[i] : qv[q - 1]*x[i]);
            if (subgroupElect()) {
                red[k][gl_SubgroupID] = v;
            }
        }
        barrier();
        if (tid < N_ACC) {
            float s = 0.0;
            for (uint g = 0; g < gl_NumSubgroups; ++g) {
                s += red[tid][g];
            }
            data_d[scr + slice*N_ACC + tid] = s;
        }
        return;
    }

    if (tid < N_ACC) {
        float s = 0.0;
        for (uint c = 0; c < n_slices; ++c) {
            s += data_d[scr + c*N_ACC + tid];
        }
        tot[tid] = s;
    }
    barrier();

    if (tid < n_query) {
        const uint q = tid;
        const float scale = inversesqrt(float(n_embd));
        float sc[MAX_STATES];
        float mx = -1.0/0.0;
        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
            if (i < n_states) {
                sc[i] = tot[MAX_STATES*(1 + q) + i]*inversesqrt(tot[i]/float(n_embd) + 1e-6)*scale;
                mx = max(mx, sc[i]);
            }
        }
        float sum = 0.0;
        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
            if (i < n_states) {
                sc[i] = exp(sc[i] - mx);
                sum += sc[i];
            }
        }
        [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
            if (i < n_states) {
                wgt[q][i] = sc[i]/sum*inversesqrt(tot[i]/float(n_embd) + 1e-6);
            }
        }
    }
    barrier();

    if (e < n_embd) {
        for (uint q = 0; q < n_query; ++q) {
            float o = 0.0;
            [[unroll]] for (uint i = 0; i < MAX_STATES; ++i) {
                if (i < n_states) {
                    o += wgt[q][i]*x[i];
                }
            }
            data_d[d_offset + q*nbd1 + t*nbd2 + e] = o;
        }
    }
}
